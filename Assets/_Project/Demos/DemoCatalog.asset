%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3153debd146ee47ea8f7e9f6ae859def, type: 3}
  m_Name: DemoCatalog
  m_EditorClassIdentifier: CardboardXR.Demos::CardboardXR.Demos.DemoCatalog
  m_LobbyScenePath: Assets/_Project/Demos/Lobby/Lobby.unity
  m_LobbyRequirements:
    SixDof: 2
    Passthrough: 2
    Hands: 2
    ScanSurfaces: 0
    KeepPlacedObjects: 0
    HandPinch: 0
  m_Demos:
  - Id: video
    Title: 360 Video
    Description: Watch 360 and VR180 videos, 2D or 3D, all around you. Tap the video for the controls. Plays videos copied to the phone or linked from Google Drive.
    Tagline: 360 and VR180 videos all around you
    Icon: 360
    Tint: {r: 0.7, g: 0.25, b: 0.29, a: 1}
    ScenePath: Assets/_Project/Demos/Video/Video.unity
    Requirements:
      SixDof: 1
      Passthrough: 1
      Hands: 1
      ScanSurfaces: 0
      KeepPlacedObjects: 0
      HandPinch: 0
  - Id: paint
    Title: Air Paint
    Description: Paint in the air around you with your hand, like Tilt Brush. Pinch to paint; look at the tool panel and pinch to change color, brush and size.
    Tagline: Paint in the air with your hand
    Icon: brush
    Tint: {r: 0.48, g: 0.31, b: 0.75, a: 1}
    ScenePath: Assets/_Project/Demos/Paint/Paint.unity
    Requirements:
      SixDof: 2
      Passthrough: 2
      Hands: 2
      ScanSurfaces: 0
      KeepPlacedObjects: 0
      HandPinch: 1
  - Id: portal
    Title: Portal
    Description: Open a doorway on your floor and walk through it into another world, then look back at your room through the door.
    Tagline: A doorway on your floor into another world
    Icon: door_front
    Tint: {r: 0.23, g: 0.25, b: 0.6, a: 1}
    ScenePath: Assets/_Project/Demos/Portal/Portal.unity
    Requirements:
      SixDof: 2
      Passthrough: 2
      Hands: 2
      ScanSurfaces: 1
      KeepPlacedObjects: 0
      HandPinch: 0
  - Id: browser
    Title: Web Cinema
    Description: Open floating desktop browser windows in your room or in a dark cinema, with quick links for YouTube, Netflix, Prime Video, Disney+, Twitch and Plex. Look and double-pinch on the watch to click.
    Tagline: Floating desktop browser windows for streaming and the web
    Icon: movie
    Tint: {r: 0.18, g: 0.42, b: 0.72, a: 1}
    ScenePath: Assets/_Project/Demos/Browser/Browser.unity
    Requirements:
      SixDof: 2
      Passthrough: 2
      Hands: 1
      ScanSurfaces: 0
      KeepPlacedObjects: 0
      HandPinch: 0
  - Id: settings
    Title: Impostazioni
    Description: "Configura la fotocamera passthrough tra obiettivo principale (6DoF) e grandangolare 0.5x per un riquadro molto pi\xF9 grande."
    Tagline: Scegli tra fotocamera principale e grandangolare 0.5x
    Icon: settings
    Tint: {r: 0.32, g: 0.42, b: 0.52, a: 1}
    ScenePath: Assets/_Project/Demos/Settings/Settings.unity
    Requirements:
      SixDof: 0
      Passthrough: 2
      Hands: 1
      ScanSurfaces: 0
      KeepPlacedObjects: 0
      HandPinch: 0
  - Id: streamcast
    Title: Schermi Live
    Description: Ricevi fino a 4 stream simultanei da Windows, macOS, iPhone, iPad e Android su schermi 3D fluttuanti (con audio, spostabili nello spazio).
    Tagline: Ricevi schermi e video live da PC, Mac, iPad e iPhone
    Icon: cast
    Tint: {r: 0.12, g: 0.52, b: 0.58, a: 1}
    ScenePath: Assets/_Project/Demos/StreamCast/StreamCast.unity
    Requirements:
      SixDof: 0
      Passthrough: 2
      Hands: 1
      ScanSurfaces: 0
      KeepPlacedObjects: 0
      HandPinch: 0
  - Id: phoneapps
    Title: App Telefono
    Description: Apri fino a 3 app reali del telefono (Chrome, TikTok, WhatsApp, ecc.) in finestre verticali o orizzontali tramite Shizuku, con tocco e scorrimento pinch 1:1.
    Tagline: App del telefono in VR con Shizuku, verticali e ruotabili
    Icon: smartphone
    Tint: {r: 0.16, g: 0.56, b: 0.42, a: 1}
    ScenePath: Assets/_Project/Demos/PhoneApps/PhoneApps.unity
    Requirements:
      SixDof: 2
      Passthrough: 2
      Hands: 2
      ScanSurfaces: 0
      KeepPlacedObjects: 0
      HandPinch: 0
  - Id: quadri
    Title: Quadri
    Description: Seleziona foto dalla galleria del telefono e posizionale come finestre pulite in giro per la stanza.
    Tagline: Metti le tue foto come quadri spaziali nella stanza
    Icon: photo_library
    Tint: {r: 0.56, g: 0.36, b: 0.78, a: 1}
    ScenePath: Assets/_Project/Demos/Quadri/Quadri.unity
    Requirements:
      SixDof: 0
      Passthrough: 2
      Hands: 1
      ScanSurfaces: 0
      KeepPlacedObjects: 0
      HandPinch: 0
  - Id: oggetti
    Title: Oggetti
    Description: Posiziona modelli 3D Poly Haven sulle superfici della stanza, spostali, ridimensionali e ruotali.
    Tagline: Posiziona oggetti 3D Poly Haven nella tua stanza
    Icon: view_in_ar
    Tint: {r: 0.18, g: 0.56, b: 0.54, a: 1}
    ScenePath: Assets/_Project/Demos/Oggetti/Oggetti.unity
    Requirements:
      SixDof: 2
      Passthrough: 2
      Hands: 1
      ScanSurfaces: 0
      KeepPlacedObjects: 0
      HandPinch: 0
